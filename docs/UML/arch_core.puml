@startuml ArchCore
title mexOS Microkernel: Arch, Core & Boot Sequence

skinparam linetype ortho
skinparam nodesep 30
skinparam ranksep 40
skinparam package {
    BackgroundColor<<Arch>> LightBlue
    BackgroundColor<<Core>> LightGreen
    BackgroundColor<<Diag>> LightSalmon
    BackgroundColor<<Exec>> Khaki
    BackgroundColor<<Lib>> Wheat
    BorderColor Black
    Shadowing false
}

package "Arch (i686)" <<Arch>> {
    [boot.s]
    [gdt.c]
    [idt.c]
    [arch.h]
}

package "Core" <<Core>> {
    [kernel.c]
    [syscall.c]
    [userland.c]
    [initrd.c]
}

package "Exec" <<Exec>> {
    [elf.c]
}

package "Diag" <<Diag>> {
    [panic.c]
}

package "Lib" <<Lib>> {
    [string.c]
    [log.c]
    [debug_utils.c]
}

package "Drivers" <<Core>> {
    package "Input" {
        [keyboard.c]
        [mouse.c]
    }
    package "Char" {
        [serial.c]
        [rtc.c]
    }
    package "Bus" {
        [pci.c]
        [acpi.c]
    }
    package "Video" {
        [vesa.c]
    }
    package "Storage" {
        [ata.c]
        [ahci.c]
    }
}

package "Filesystem" <<Core>> {
    [fs.c]
    [diskfs.c]
}

' Boot sequence (all driven directly by kernel.c, per kernel_main())
[boot.s] --> [kernel.c]
[kernel.c] --> [gdt.c]
[kernel.c] --> [idt.c]
[kernel.c] --> [elf.c] : elf_init_symbols()
[kernel.c] --> [panic.c] : kernel_panic()
[kernel.c] --> [log.c] : log_init()
[kernel.c] --> [syscall.c] : syscall_init()
[kernel.c] --> [keyboard.c]
[kernel.c] --> [mouse.c]
[kernel.c] --> [vesa.c]
[kernel.c] --> [rtc.c]
[kernel.c] --> [pci.c]
[kernel.c] --> [acpi.c]
[kernel.c] --> [ata.c]
[kernel.c] --> [ahci.c]
[kernel.c] --> [fs.c]
[kernel.c] --> [initrd.c]
[kernel.c] --> [userland.c]

' Verified cross-module calls
[idt.c] --> [rtc.c] : shares interrupt vectors
[syscall.c] --> [elf.c] : do_exec()
[syscall.c] --> [fs.c]
[userland.c] --> [elf.c]
[userland.c] --> [initrd.c]
[elf.c] --> [fs.c] : fs_read()
[fs.c] --> [diskfs.c]
[diskfs.c] --> [ata.c]
[log.c] --> [string.c]
[debug_utils.c] --> [elf.c] : symbol lookup
[panic.c] --> [serial.c]
[panic.c] --> [string.c]

legend right
| Color | Layer |
| LightBlue | Arch |
| LightGreen | Core / Drivers / Filesystem |
| Khaki | Exec |
| LightSalmon | Diag |
| Wheat | Lib |
endlegend

@enduml