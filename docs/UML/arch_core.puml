@startuml ArchCore
title mexOS Microkernel: Arch & Core

skinparam linetype ortho
skinparam package {
    BackgroundColor<<Arch>> LightBlue
    BackgroundColor<<Core>> LightGreen
    BackgroundColor<<Diag>> LightSalmon
    BackgroundColor<<Exec>> Khaki
    BackgroundColor<<Lib>> Wheat
    BorderColor Black
    Shadowing false
}

' =========================
' ARCH (i686)
' =========================
package "Arch (i686)" <<Arch>> {
    [boot.s]
    [gdt_asm.s]
    [gdt.c]
    [gdt.h]
    [idt_asm.s]
    [idt.c]
    [idt.h]
    [arch.h]
}

' =========================
' CORE (kernel/user boundary + bootstrap only)
' =========================
package "Core" <<Core>> {
    [kernel.c]
    [kernel.h]
    [syscall.c]
    [syscall.h]
    [initrd.h]
}

' =========================
' EXEC (program loading)
' =========================
package "Exec" <<Exec>> {
    [elf.c]
    [elf.h]
}

' =========================
' DIAG (diagnostics / fault handling)
' =========================
package "Diag" <<Diag>> {
    [panic.c]
    [panic.h]
}

' =========================
' LIB (freestanding utilities)
' =========================
package "Lib" <<Lib>> {
    [string.c]
    [string.h]
    [log.c]
    [log.h]
    [debug_utils.c]
    [debug_utils.h]
}

' =========================
' DRIVER LAYER
' =========================
package "Drivers" <<Core>> {

    package "Input" {
        [keyboard.c]
        [keyboard.h]
    }

    package "Char" {
        [serial.c]
        [serial.h]
        [rtc.c]
        [rtc.h]
    }

    package "Bus" {
        [pci.c]
        [pci.h]
        [acpi.c]
        [acpi.h]
    }

    package "Video" {
        [vesa.c]
        [vesa.h]
    }

    package "Storage" {
        [ata.c]
        [ata.h]
        [ahci.c]
        [ahci.h]
    }
}

' =========================
' FS
' =========================
package "Filesystem" <<Core>> {
    [fs.c]
    [fs.h]
    [vfs.h]
    [diskfs.c]
    [diskfs.h]
}

' Dependencies
[boot.s] --> [gdt.c]
[gdt.c] --> [idt.c]
[idt.c] --> [kernel.c]

[kernel.c] --> [syscall.c]
[syscall.c] --> [elf.c]
[kernel.c] --> [panic.c]

[elf.c] --> [fs.c]
[fs.c] --> [diskfs.c]
[diskfs.c] --> [ata.c]
[diskfs.c] --> [ahci.c]

[kernel.c] --> [log.c]
[kernel.c] --> [string.c]
[log.c] --> [serial.c]

[kernel.c] --> [keyboard.c]
[kernel.c] --> [vesa.c]
[kernel.c] --> [rtc.c]
[kernel.c] --> [pci.c]
[pci.c] --> [acpi.c]

' Legend
legend right
| Color | Layer |
| LightBlue | Arch |
| LightGreen | Core / Drivers / Filesystem |
| Khaki | Exec |
| LightSalmon | Diag |
| Wheat | Lib |
endlegend

@enduml
