@startuml MM_Sched_IPC
title mexOS Microkernel: Memory, Scheduler, Sync & IPC

skinparam linetype ortho
skinparam nodesep 30
skinparam ranksep 40
skinparam package {
    BackgroundColor<<Core>> LightGreen
    BackgroundColor<<MM>> LightYellow
    BackgroundColor<<Scheduler>> LightCoral
    BackgroundColor<<Sync>> Plum
    BackgroundColor<<IPC>> LightPink
    BorderColor Black
    Shadowing false
}

package "Core" <<Core>> {
    [kernel.c]
}

package "Memory Management" <<MM>> {
    [pmm.c]
    [heap.c]
    [vmm.c]
    [alloc_track.c]
}

package "Scheduler" <<Scheduler>> {
    [sched.c]
    [timer.c]
    [switch.s]
}

package "Sync" <<Sync>> {
    [spinlock.c]
}

package "IPC" <<IPC>> {
    [ipc.c]
}

' kernel.c drives init order: pmm -> heap -> vmm -> ipc -> sched -> timer
[kernel.c] --> [pmm.c]
[kernel.c] --> [heap.c]
[kernel.c] --> [vmm.c]
[kernel.c] --> [ipc.c]
[kernel.c] --> [sched.c]
[kernel.c] --> [timer.c]

[pmm.c] --> [alloc_track.c]
[heap.c] --> [alloc_track.c]
[vmm.c] --> [pmm.c]
[alloc_track.c] --> [spinlock.c]

[timer.c] --> [sched.c] : sched_tick() each IRQ0
[sched.c] --> [switch.s] : context switch
[sched.c] --> [spinlock.c]
[sched.c] --> [heap.c]
[sched.c] --> [vmm.c]
[sched.c] --> [ipc.c] : owns message ports

[ipc.c] --> [heap.c]
[ipc.c] --> [sched.c] : blocks/wakes tasks

note bottom of [ipc.c]
  sched.c and ipc.c mutually
  include each other's headers
  (ports live in sched, IPC blocks tasks)
end note

legend right
| Color | Layer |
| LightYellow | Memory Management |
| LightCoral | Scheduler |
| Plum | Sync |
| LightPink | IPC |
endlegend

@enduml