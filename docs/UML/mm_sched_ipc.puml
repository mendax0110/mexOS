@startuml MM_Sched_IPC
title mexOS Microkernel: Memory, Scheduler, Sync & IPC

skinparam linetype ortho
skinparam package {
    BackgroundColor<<MM>> LightYellow
    BackgroundColor<<Scheduler>> LightCoral
    BackgroundColor<<Sync>> Plum
    BackgroundColor<<IPC>> LightPink
    BorderColor Black
    Shadowing false
}

' ============================
' MEMORY MANAGEMENT
' ============================
package "Memory Management" <<MM>> {
    [heap.c]
    [heap.h]
    [pmm.c]
    [pmm.h]
    [vmm.c]
    [vmm.h]
    [alloc_track.c]
    [alloc_track.h]
}

' ============================
' SCHEDULER (now owns the timer tick)
' ============================
package "Scheduler" <<Scheduler>> {
    [sched.c]
    [sched.h]
    [switch.s]
    [timer.c]
    [timer.h]
}

' ============================
' SYNC
' ============================
package "Sync" <<Sync>> {
    [spinlock.c]
    [spinlock.h]
}

' ============================
' IPC
' ============================
package "IPC" <<IPC>> {
    [ipc.c]
    [ipc.h]
}

' Dependencies to Core
[heap.c] --> [kernel.c]
[pmm.c] --> [kernel.c]
[vmm.c] --> [kernel.c]
[heap.c] --> [alloc_track.c]
[vmm.c] --> [pmm.c]

[timer.c] --> [sched.c]
[sched.c] --> [switch.s]
[sched.c] --> [kernel.c]
[sched.c] --> [spinlock.c]

[ipc.c] --> [kernel.c]
[ipc.c] --> [spinlock.c]
[ipc.c] --> [sched.c]

' Legend
legend right
| Color | Layer |
| LightYellow | Memory Management |
| LightCoral | Scheduler |
| Plum | Sync |
| LightPink | IPC |
endlegend

@enduml
