@startuml UI_Apps_SysMon_User
title mexOS Microkernel: UI, Apps, SysMon & Userland

skinparam linetype ortho
skinparam nodesep 30
skinparam ranksep 40
skinparam package {
    BackgroundColor<<Core>> LightGreen
    BackgroundColor<<UI>> LightCyan
    BackgroundColor<<Apps>> LightGoldenRodYellow
    BackgroundColor<<SysMon>> Thistle
    BackgroundColor<<User>> LightOrange
    BorderColor Black
    Shadowing false
}

package "Core" <<Core>> {
    [kernel.c]
    [syscall.c]
}

package "UI" <<UI>> {
    [console.c]
    [vterm.c]
    [basic.c]
    [tui.c]
}

package "Apps" <<Apps>> {
    [shell.c]
    [editor.c]
    [disk_installer.c]
}

package "SysMon" <<SysMon>> {
    [sysmon.c]
}

package "User Space" <<User>> {
    package "init" {
        [init.c]
    }
    package "lib" {
        [crt0.s]
        [user_syscall.h] as usc
    }
    [bin programs] as bins
}

[kernel.c] --> [shell.c] : CONFIG_KERNEL_SHELL
[console.c] --> [vterm.c]

[shell.c] --> [console.c]
[shell.c] --> [tui.c]
[shell.c] --> [disk_installer.c]
[shell.c] --> [editor.c]
[shell.c] --> [sysmon.c] : sysmon_init()
[shell.c] --> [basic.c] : basic_init()

[tui.c] --> [console.c]
[tui.c] --> [editor.c]

[editor.c] --> [console.c]
[editor.c] --> [basic.c]

[disk_installer.c] --> [console.c]

[sysmon.c] --> [console.c]

[basic.c] --> [console.c]
[basic.c] ..> usc : #include (kernel\nincludes user header — verify)

bins --> usc : syscall wrappers
[init.c] --> usc
usc ..> [syscall.c] : int 0x80 trap\n(runtime, not compile-time)

legend right
| Color | Layer |
| LightCyan | UI |
| LightGoldenRodYellow | Apps |
| Thistle | SysMon |
| LightOrange | User Space |
| LightGreen | Core |
endlegend

@enduml