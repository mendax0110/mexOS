# GRUB configuration for mexOS bootable ISO
# Compatible with BIOS/legacy hardware and UEFI systems

# Load essential modules for filesystem and boot support
insmod part_msdos
insmod part_gpt
insmod iso9660
insmod fat
insmod ext2
insmod biosdisk
insmod multiboot
insmod normal
insmod gfxterm

# Video support modules for compatibility with various hardware
insmod all_video
insmod vbe
insmod vga

# Set root device - search for the ISO filesystem by label
set root=(cd)
search --no-floppy --set=root --label MEXOS

# Boot configuration
set timeout=5
set default=1
set gfxpayload=text

# Disable graphical terminal for maximum compatibility
terminal_output console
terminal_input console

menuentry 'mexOS (console)' {
    echo "Loading mexOS console..."
    terminal_output console
    set gfxpayload=text
    multiboot /boot/mexOS.elf console
    echo "Booting..."
}

menuentry 'mexOS (desktop)' {
    echo "Loading mexOS desktop..."
    set gfxmode=1024x768x32,1024x768x24,1024x768x16,800x600x32,800x600x24,800x600x16,640x480x32,640x480x24,640x480x16,auto
    terminal_output gfxterm
    set gfxpayload=keep
    multiboot /boot/mexOS-gfx.elf desktop
    echo "Booting..."
}

menuentry 'mexOS (desktop compatibility - 800x600)' {
    echo "Loading mexOS desktop in hardware compatibility mode..."
    set gfxmode=800x600x16,800x600x24,800x600x32,640x480x16,640x480x24,640x480x32
    terminal_output gfxterm
    set gfxpayload=keep
    multiboot /boot/mexOS-gfx.elf desktop compatibility
    echo "Booting..."
}

menuentry 'mexOS (safe mode - no framebuffer)' {
    echo "Loading mexOS kernel in safe mode..."
    terminal_output console
    set gfxpayload=text
    multiboot /boot/mexOS.elf console safe
    echo "Booting..."
}

menuentry 'mexOS (kernel recovery console)' {
    echo "Loading mexOS kernel recovery console..."
    terminal_output console
    set gfxpayload=text
    multiboot /boot/mexOS.elf kernel-console console
    echo "Booting..."
}
