#ifndef MEXOS_AUTOCONF_H
#define MEXOS_AUTOCONF_H

#include "assert.h"

#cmakedefine01 CONFIG_MEXOS_TESTS
#cmakedefine01 CONFIG_RUN_SELFTESTS
#cmakedefine01 CONFIG_DRIVER_ATA
#cmakedefine01 CONFIG_DRIVER_AHCI
#cmakedefine01 CONFIG_DRIVER_ACPI
#cmakedefine01 CONFIG_DRIVER_PCI
#cmakedefine01 CONFIG_DRIVER_VESA
#cmakedefine01 CONFIG_KERNEL_SHELL
#cmakedefine01 CONFIG_KERNEL_EDITOR
#cmakedefine01 CONFIG_KERNEL_BASIC
#cmakedefine01 CONFIG_INITRD
#cmakedefine01 CONFIG_BOOT_DISK_INSTALLER

#define CONFIG_KERNEL_HEAP_SIZE @CONFIG_KERNEL_HEAP_SIZE@
#define CONFIG_KERNEL_STACK_SIZE @CONFIG_KERNEL_STACK_SIZE@
#define CONFIG_USER_STACK_SIZE @CONFIG_USER_STACK_SIZE@
#define CONFIG_FS_MAX_FILE_SIZE @CONFIG_FS_MAX_FILE_SIZE@
#define CONFIG_TICK_FREQUENCY_HZ @CONFIG_TICK_FREQUENCY_HZ@
#define CONFIG_MAX_PORTS @CONFIG_MAX_PORTS@

STATIC_ASSERT(CONFIG_FS_MAX_FILE_SIZE < CONFIG_KERNEL_STACK_SIZE / 2,
    "FS_MAX_FILE_SIZE is too close to KERNEL_STACK_SIZE - any stack-local "
    "buffer of this size will overflow the kernel stack. Heap-allocate it "
    "instead, or if you want you can also shrink FS_MAX_FILE_SIZE / grow KERNEL_STACK_SIZE.");

#endif
