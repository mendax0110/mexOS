-static void copy_string(char* dst, const size_t dst_size, const char* src)
-{
-    if (!dst || dst_size == 0)
-    {
-        return;
-    }
-
-    size_t i = 0;
-    if (src)
-    {
-        while (src[i] && i + 1 < dst_size)
-        {
-            dst[i] = src[i];
-            i++;
-        }
-    }
-    dst[i] = '\0';
-}
