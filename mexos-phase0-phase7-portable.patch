-
-    for (int i = 0; i < count && i < 5; i++)
-    {
-        char line[GUI_LOG_LEN];
-        copy_string(line, sizeof(line), entries[i].type == FS_ABI_TYPE_DIR ? "[DIR] " : "[BIN] ");
