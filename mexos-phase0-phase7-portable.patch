+        case SYS_POLL_FD:
+        {
+            return fs_poll_fd((int)arg1, (int)arg2);
+        }
+        case SYS_SETPGID:
+        {
+            struct task* target = arg1 == 0 ? sched_get_current() : task_find((pid_t)arg1);
