+        case SYS_GETPGID:
+        {
+            const struct task* target = arg1 == 0 ? sched_get_current() : task_find((pid_t)arg1);
+            return target ? target->process_group : -1;
+        }
+        case SYS_MUNMAP:
+        {
+            return unmap_anon_from_user(arg1, arg2);
