-static void int_to_dec(int value, char* out, const size_t out_size)
-{
-    if (!out || out_size == 0)
-    {
-        return;
-    }
-
-    if (value == 0)
-    {
-        copy_string(out, out_size, "0");
-        return;
-    }
-
-    char temp[12];
-    int pos = 0;
-    bool neg = false;
-    if (value < 0)
-    {
-        neg = true;
-        value = -value;
-    }
-
-    while (value > 0 && pos < (int)sizeof(temp))
-    {
-        temp[pos++] = (char)('0' + (value % 10));
-        value /= 10;
-    }
-
-    size_t out_pos = 0;
-    if (neg && out_pos + 1 < out_size)
-    {
-        out[out_pos++] = '-';
-    }
-
-    while (pos > 0 && out_pos + 1 < out_size)
-    {
-        out[out_pos++] = temp[--pos];
-    }
-    out[out_pos] = '\0';
-}
-
-static void uint_to_dec(uint32_t value, char* out, const size_t out_size)
-{
-    if (!out || out_size == 0)
-    {
-        return;
-    }
-
-    if (value == 0)
-    {
-        copy_string(out, out_size, "0");
-        return;
-    }
-
-    char temp[12];
-    int pos = 0;
-    while (value > 0 && pos < (int)sizeof(temp))
-    {
-        temp[pos++] = (char)('0' + (value % 10U));
-        value /= 10U;
-    }
-
-    size_t out_pos = 0;
-    while (pos > 0 && out_pos + 1 < out_size)
-    {
-        out[out_pos++] = temp[--pos];
-    }
-    out[out_pos] = '\0';
-}
