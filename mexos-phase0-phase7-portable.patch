-+        }
-+        else if (state->launcher_index == 1)
-+        {
-+            state->view = GUI_VIEW_TERMINAL;
-+        }
-+        else if (state->launcher_index == 2)
-+        {
-+            state->view = GUI_VIEW_SYSTEM;
